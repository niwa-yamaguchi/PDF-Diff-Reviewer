{
  "name": "modular-refactoring",
  "version": "1.0.0",
  "description": "改訂前後のPDF図面を読み込み、変更箇所を色分けしてオーバーレイ表示するブラウザ内ツールです。設計変更レビューで大量の図面を目視照合する負担・見落としを減らすことを目的としています。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/fixtures/generate-fixtures.mjs && playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "dependencies": {
    "diff-match-patch": "1.0.5",
    "jspdf": "2.5.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "vite": "8.2.1",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.10"
  }
}
